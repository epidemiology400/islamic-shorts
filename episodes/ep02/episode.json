   "text": "تقولُه وأنت تمشي… أو تنتظر…\nأو قبل أن تنام"
  },
  {
   "start": 12.423,
   "end": 14.903,
   "text": "قال النبيُّ ﷺ:",
   "spoken": "قال النبي صلى الله عليه وسلم"
  },
  {
   "start": 15.261,
   "end": 17.073,
   "text": "«كَلِمَتَانِ خَفِيفَتَانِ عَلَى اللِّسَانِ،",
   "style": "hadith",
   "highlight": [
    "خَفِيفَتَانِ"
   ]
  },
  {
   "start": 17.43,
   "end": 18.909,
   "text": "ثَقِيلَتَانِ فِي الْمِيزَانِ،",
   "style": "hadith",
   "highlight": [
    "ثَقِيلَتَانِ"
   ]
  },
  {
   "start": 19.267,
   "end": 20.745,
   "text": "حَبِيبَتَانِ إِلَى الرَّحْمَنِ:",
   "style": "hadith",
   "highlight": [
    "حَبِيبَتَانِ"
   ]
  },
  {
   "start": 21.103,
   "end": 23.582,
   "text": "سُبْحَانَ اللهِ الْعَظِيمِ،\nسُبْحَانَ اللهِ وَبِحَمْدِهِ»",
   "style": "hadith",
   "highlight": [
    "سُبْحَانَ اللهِ الْعَظِيمِ",
    "سُبْحَانَ اللهِ وَبِحَمْدِهِ"
   ]
  },
  {
   "start": 23.94,
   "end": 25.085,
   "text": "متفقٌ عليه\nالبخاري (6406) · مسلم (2694)",
   "ref_second_line": true,
   "spoken": "متفقن عليه"
  },
  {
   "start": 25.442,
   "end": 26.921,
   "text": "ثلاثُ صفات… تأمّلها"
  },
  {
   "start": 27.278,
   "end": 29.091,
   "text": "خفيفتان… لا تُتعبان لسانك",
   "highlight": [
    "خفيفتان"
   ]
  },
  {
   "start": 29.448,
   "end": 31.594,
   "text": "ثقيلتان… في ميزانك يومَ القيامة",
   "highlight": [
    "ثقيلتان"
   ]
  },
  {
   "start": 31.952,
   "end": 33.43,
   "text": "حبيبتان… إلى الرحمن",
   "highlight": [
    "حبيبتان"
   ]
  },
  {
   "start": 33.788,
   "end": 36.602,
   "text": "فما أعظمَ أن يحبَّ اللهُ ما تقول!"
  },
  {
   "start": 36.959,
   "end": 39.439,
   "text": "«سبحان الله»: تنزيهُه عن كلِّ نقص",
   "highlight": [
    "سبحان الله"
   ]
  },
  {
   "start": 39.797,
   "end": 41.609,
   "text": "«وبحمده»: الثناءُ عليه بكماله",
   "highlight": [
    "وبحمده"
   ]
  },
  {
   "start": 41.967,
   "end": 43.445,
   "text": "وقال اللهُ تعالى:"
  },
  {
   "start": 43.803,
   "end": 46.616,
   "text": "﴿الَّذِينَ آمَنُوا وَتَطْمَئِنُّ قُلُوبُهُم\nبِذِكْرِ اللَّهِ ۗ",
   "style": "quran"
  },
  {
   "start": 46.974,
   "end": 49.12,
   "text": "أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ﴾\n[الرعد: 28]",
   "style": "quran",
   "ref_second_line": true,
   "spoken": "ألا بذكر الله تطمئن القلوب"
  },
  {
   "start": 49.478,
   "end": 52.291,
   "text": "في زحمة يومك… في قلقك…\nفي انتظارك…"
  },
  {
   "start": 52.649,
   "end": 54.128,
   "text": "اجعلهما على لسانك",
   "highlight": [
    "على لسانك"
   ]
  },
  {
   "start": 54.485,
   "end": 56.965,
   "text": "الآن… قبل أن تُغلق هذا المقطع",
   "highlight": [
    "الآن"
   ]
  },
  {
   "start": 57.323,
   "end": 58.467,
   "text": "قُلهما معي:"
  },
  {
   "start": 58.825,
   "end": 61.305,
   "text": "سبحان الله العظيم…\nسبحان الله وبحمده",
   "highlight": [
