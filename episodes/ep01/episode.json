 "cues": [
  {
   "start": 0.16,
   "end": 1.66,
   "text": "في كلِّ ليلة…"
  },
  {
   "start": 1.7,
   "end": 4.782,
   "text": "ساعةٌ يغفُل عنها أكثرُ الناس",
   "highlight": [
    "ساعةٌ"
   ]
  },
  {
   "start": 4.822,
   "end": 6.602,
   "text": "حين ينامُ الجميع…"
  },
  {
   "start": 6.642,
   "end": 8.482,
   "text": "ويهدأُ كلُّ شيء…"
  },
  {
   "start": 8.522,
   "end": 10.902,
   "text": "ويبقى ثلثُ الليلِ الأخير…",
   "highlight": [
    "ثلثُ الليلِ الأخير"
   ]
  },
  {
   "start": 10.942,
   "end": 13.582,
   "text": "أخبرنا النبيُّ ﷺ",
   "spoken": "أخبرنا النبي صلى الله عليه وسلم"
  },
  {
   "start": 13.622,
   "end": 16.732,
   "text": "بما يكون في تلك الساعة، فقال:"
  },
  {
   "start": 16.772,
   "end": 21.432,
   "text": "«يَنْزِلُ رَبُّنَا تَبَارَكَ وَتَعَالَى\nكُلَّ لَيْلَةٍ إِلَى السَّمَاءِ الدُّنْيَا،",
   "style": "hadith"
  },
  {
   "start": 21.472,
   "end": 23.682,
   "text": "حِينَ يَبْقَى ثُلُثُ اللَّيْلِ الْآخِرُ،",
   "style": "hadith"
  },
  {
   "start": 23.722,
   "end": 26.902,
   "text": "يَقُولُ: مَنْ يَدْعُونِي\nفَأَسْتَجِيبَ لَهُ؟",
   "style": "hadith",
   "highlight": [
    "فَأَسْتَجِيبَ لَهُ"
   ]
  },
  {
   "start": 26.942,
   "end": 28.902,
   "text": "مَنْ يَسْأَلُنِي فَأُعْطِيَهُ؟",
   "style": "hadith",
   "highlight": [
    "فَأُعْطِيَهُ"
   ]
  },
  {
   "start": 28.942,
   "end": 32.122,
   "text": "مَنْ يَسْتَغْفِرُنِي فَأَغْفِرَ لَهُ؟»",
   "style": "hadith",
   "highlight": [
    "فَأَغْفِرَ لَهُ"
   ]
  },
  {
   "start": 32.342,
   "end": 34.622,
   "text": "متفقٌ عليه\nالبخاري (1145) · مسلم (758)",
   "ref_second_line": true,
   "spoken": "متفق عليه"
  },
  {
   "start": 34.672,
   "end": 36.887,
   "text": "همٌّ أثقلَ صدرَك؟",
   "highlight": [
    "همٌّ"
   ]
  },
  {
   "start": 36.927,
   "end": 39.267,
   "text": "حاجةٌ لم تُخبر بها أحداً؟",
   "highlight": [
    "حاجةٌ"
   ]
  },
  {
   "start": 39.307,
   "end": 41.107,
   "text": "ذنبٌ تخجلُ منه؟",
   "highlight": [
    "ذنبٌ"
   ]
  },
  {
   "start": 41.147,
   "end": 45.567,
   "text": "من يدعوني… من يسألني…\nمن يستغفرني…"
  },
  {
   "start": 45.607,
   "end": 47.247,
   "text": "وقال اللهُ تعالى:"
  },
  {
   "start": 47.287,
   "end": 50.987,
   "text": "﴿وَإِذَا سَأَلَكَ عِبَادِي عَنِّي\nفَإِنِّي قَرِيبٌ ۖ",
   "style": "quran"
  },
  {
   "start": 51.027,
   "end": 54.527,
   "text": "أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ﴾\n[البقرة: 186]",
   "style": "quran",
   "ref_second_line": true,
   "spoken": "أجيب دعوة الداع إذا دعان"
  },
  {
   "start": 55.507,
   "end": 57.087,
   "text": "الليلة… قبل أن تنام…",
   "highlight": [
    "الليلة"
   ]
  },
  {
   "start": 57.127,
   "end": 59.327,
   "text": "اضبط منبّهك على الثلث الأخير",
   "highlight": [
    "الثلث الأخير"
   ]
  },
  {
   "start": 59.367,
   "end": 62.667,
   "text": "واكتب حاجتك…\nثم قُم وادعُ ربَّك",
   "highlight": [
    "حاجتك"
   ]
  },
  {
   "start": 62.707,
   "end": 67.507,
   "text": "وأرسلها لمن تحب…\nلعلّه يقومُ معك"
  }
 ],
