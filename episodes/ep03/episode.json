   ],
   "spoken": "كلمه واحدة"
  },
  {
   "start": 1.32,
   "end": 3.634,
   "text": "قد تجبرُ قلباً… وقد تكسرُه",
   "highlight": [
    "تجبرُ",
    "تكسرُه"
   ]
  },
  {
   "start": 3.674,
   "end": 6.354,
   "text": "فبماذا تُحدّثُ الناسَ اليوم؟"
  },
  {
   "start": 6.394,
   "end": 8.954,
   "text": "قال النبيُّ ﷺ:"
  },
  {
   "start": 8.994,
   "end": 11.554,
   "text": "«مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ،",
   "style": "hadith"
  },
  {
   "start": 11.594,
   "end": 13.614,
   "text": "فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ»",
   "style": "hadith",
   "highlight": [
    "خَيْرًا",
    "لِيَصْمُتْ"
   ],
   "spoken": "فليقل خيرن أو ليصمت"
  },
  {
   "start": 13.654,
   "end": 15.539,
   "text": "متفقٌ عليه\nالبخاري (6475) · مسلم (47)",
   "ref_second_line": true,
   "spoken": "رواه البخاري ومسلم"
  },
  {
   "start": 15.579,
   "end": 19.159,
   "text": "ربطَ الكلمةَ بالإيمان\nبالله واليوم الآخر",
   "highlight": [
    "بالإيمان"
   ]
  },
  {
   "start": 19.199,
   "end": 20.779,
   "text": "فإمّا خيرٌ تقولُه…",
   "highlight": [
    "خيرٌ"
   ],
   "spoken": "فإما خيرن تقوله"
  },
  {
   "start": 20.819,
   "end": 23.739,
   "text": "وإمّا صمتٌ تحفظُ به لسانك",
   "highlight": [
    "صمتٌ"
   ],
   "spoken": "وإما صمتن تحفظ به لسانك"
  },
  {
   "start": 23.779,
   "end": 25.259,
   "text": "وقال اللهُ تعالى:"
  },
  {
   "start": 25.299,
   "end": 26.939,
   "text": "﴿مَا يَلْفِظُ مِن قَوْلٍ",
   "style": "quran",
   "spoken": "ما يلفظ من قولن"
  },
  {
   "start": 26.979,
   "end": 29.259,
   "text": "إِلَّا لَدَيْهِ رَقِيبٌ عَتِيدٌ﴾\n[ق: 18]",
   "style": "quran",
   "ref_second_line": true,
   "spoken": "إلا لديه رقيبن عتيد"
  },
  {
   "start": 29.299,
   "end": 33.219,
   "text": "فما من كلمةٍ تلفظُها…\nإلا وعندها رقيب",
   "highlight": [
    "رقيب"
   ],
   "spoken": "فما من كلمتن تلفظها إلا وعندها رقيب"
  },
  {
   "start": 33.259,
   "end": 38.379,
   "text": "كم من كلمةٍ قلناها ونسيناها…\nوهي عند الله لا تُنسى",
   "spoken": "كم من كلمتن قلناها ونسيناها وهي عند الله لا تنسى"
  },
  {
   "start": 38.419,
   "end": 41.179,
   "text": "قبل أن تتكلّم، اسألْ نفسك:"
  },
  {
   "start": 41.219,
   "end": 42.419,
   "text": "هل هذا خير؟",
   "highlight": [
    "خير"
   ]
  },
  {
   "start": 42.459,
   "end": 46.779,
   "text": "فإن كان خيراً فقُلْه…\nوإلا فالصمتُ أسلم",
   "spoken": "فإن كان خيرن فقله وإلا فالصمت أسلم"
  },
  {
   "start": 46.819,
   "end": 50.819,
   "text": "في غضبك… في مُزاحك…\nفي رسائلك وتعليقاتك"
  },
  {
   "start": 50.859,
   "end": 52.899,
   "text": "قُلْ خيراً… أو اصمُت",
   "highlight": [
    "قُلْ خيراً",
    "اصمُت"
   ]
  },
  {
   "start": 52.939,
   "end": 56.859,
   "text": "اللهمّ اجعل ألسنتنا\nلا تنطقُ إلا بخير",
   "highlight": [
    "إلا بخير"
   ]
  },
  {
   "start": 56.899,
   "end": 62.596,
   "text": "وأرسلْ هذا المقطع لمن تحب…\nلعلّ كلمةً منه تبقى معه",
   "spoken": "وأرسل هذا المقطع لمن تحب لعل كلمتن منه تبقى معه"
  }
